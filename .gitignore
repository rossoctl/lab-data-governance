__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.coverage
.ruff_cache/
build/
dist/
uv.lock

# Agent tooling (Claude Code skills, agent definitions) installed locally and
# not part of this project. The `otel-span-table` skill IS checked in, so it is
# re-included below; everything else under these paths is ignored.
.agents/
.claude/skills/
!.claude/skills/otel-span-table/
!.claude/skills/otel-span-table/**
skills-lock.json

# Pipeline runtime output
classification/output/

# React SPA build output (ADR-0019): the Containerfile's Node stage copies
# Vite's dist/ into data_governance/api/ui/ (the _UI_DIR the backend serves).
# The built assets are generated, never committed — keep only the .gitkeep.
/data_governance/api/ui/*
!/data_governance/api/ui/.gitkeep

# Local working notes for the two-span lineage branch — kept out of the PR
# deliberately; only the wire contract (docs/sidecar-wire-contract.md) ships.
/docs/CUTOVER-two-span.md
/docs/REVIEWER-QUICKSTART.md
/docs/reading-the-sidecar-algorithm.md
/docs/adr/0029-sidecar-two-span-interactions-algorithm.md
