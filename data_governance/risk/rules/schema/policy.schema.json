                        "social_media": { "$ref": "#/$defs/dataCategoryValues" },
                        "unknown": { "$ref": "#/$defs/dataCategoryValues" }
                    },
                    "additionalProperties": false
                }
            }
        },

        "rule": {
            "type": "object",
            "required": ["rule_name", "rule_id", "rule_categories", "rule_sources", "rule_decision"],
            "additionalProperties": false,
            "properties": {
                "rule_name": { "type": "string" },
                "rule_id": { "type": "string" },
                "rule_categories": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/ruleCategoriesValues" }
                },
                "rule_sources": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/ruleSource" }
                },
                "event_type": { "$ref": "#/$defs/eventTypeValues" },
                "data_sources": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dataSource" }
                },
                "data_items": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dataItem" }
                },
                "data_count": { "type": "integer", "minimum": 0 },
                "data_destinations": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dataDestination" }
                },
                "data_lineage": { "$ref": "#/$defs/dataLineage" },
                "requested_actions": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/actionTypeValues" }
                },
                "declared_business_intent": { "type": "string" },
                "observed_business_intent": { "type": "string" },
                "observed_business_intent_description": { "type": "string" },
                "declared_operational_intent": { "type": "string" },
                "observed_operational_intent": { "type": "string" },
                "accessing_user": { "$ref": "#/$defs/accessingUser" },
                "processing_agents": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/processingAgent" }
                },
                "scope": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/scopeEntry" }
                },
                "rule_decision": { "$ref": "#/$defs/ruleDecision" }
            }
        },

        "ruleSource": {
            "type": "object",
            "required": ["document_name"],
            "additionalProperties": false,
            "properties": {
                "document_name": { "type": "string" },
                "version": { "type": "string" },
                "section": { "type": "string" },
                "article/clause": { "type": "string" }
            }
        },

        "dataSource": {
            "type": "object",
            "required": [ ],
            "additionalProperties": false,
            "properties": {
                "data_source_name": { "type": "string" },
                "data_source_url": { "type": "string" },
                "data_source_types": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dataSourceTypeValues" }
                },
                "data_source_categories": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dataCategoryValues" }
                }
            }
        },

        "dataDestination": {
            "type": "object",
            "required": [ ],
            "additionalProperties": false,
            "properties": {
                "data_destination_name": { "type": "string" },
                "data_destination_url": { "type": "string" },
                "data_destination_types": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dataDestinationTypeValues" }
                },
                "data_destination_categories": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dataCategoryValues" }
                },
                "data_destination_trust_level": { "$ref": "#/$defs/trustLevelValues" }
            }
        },

        "entity": {
            "type": "object",
            "required": [ ],
            "additionalProperties": false,
            "properties": {
                "entity_type": { "$ref": "#/$defs/entityTypeValues" },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 },
                "text": { "type": "string" },
                "domain": { "$ref": "#/$defs/domainValues" },
                "category": { "$ref": "#/$defs/categoryValues" },
                "regulatory_tags": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/regulatoryTagsValues" }
                },
                "data_type": { "$ref": "#/$defs/dataTypeValues" },
                "classification_level": { "$ref": "#/$defs/classificationLevelValues" },
                "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "data_state": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dataStateValues" }
                }
            }
        },

        "dataItem": {
            "type": "object",
            "required": [ ],
            "additionalProperties": false,
            "properties": {
                "text": { "type": "string" },
                "entities": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/entity" }
                },
                "list_of_entities": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/entityTypeValues" }
                },
                "list_of_domains": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/domainValues" }
                },
                "classification_level": { "$ref": "#/$defs/classificationLevelValues" },
                "primary_domain": { "$ref": "#/$defs/domainValues" },
                "regulatory_tags": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/regulatoryTagsValues" }
                },
                "identity_bundles": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },

        "dataLineage": {
            "type": "object",
            "required": [ ],
            "additionalProperties": false,
            "properties": {
                "source": {
                    "type": "object",
                    "required": ["source_url", "source_type"],
                    "additionalProperties": false,
                    "properties": {
                        "source_name": { "type": "string" },
                        "source_url": { "type": "string" },
                        "source_type": { "type": "string" }
                    }
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["action_type"],
                        "additionalProperties": false,
                        "properties": {
                            "action_type": { "$ref": "#/$defs/actionTypeValues" },
                            "location": { "type": "string" },
                            "location_type": { "$ref": "#/$defs/locationTypeValues" }
                        }
                    }
                },
                "processing_steps": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["processing_entity"],
                        "additionalProperties": false,
                        "properties": {
                            "processing_entity": { "type": "string" },
                            "processing_entity_type": { "$ref": "#/$defs/processingEntityTypeValues" }
                        }
                    }
                },
                "transformations": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/transformationTypeValues" }
                }
            }
        },

        "accessingUser": {
            "type": "object",
            "required": ["username", "user_roles"],
            "additionalProperties": false,
            "properties": {
                "username": { "type": "string" },
                "user_roles": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },

        "processingAgent": {
            "type": "object",
            "required": ["agent_name"],
            "additionalProperties": false,
            "properties": {
                "agent_name": { "type": "string" },
                "agent_trust_level": { "$ref": "#/$defs/trustLevelValues" }
            }
        },

        "scopeEntry": {
            "type": "object",
            "required": ["action_type", "count", "time_span"],
            "additionalProperties": false,
            "properties": {
                "action_type": { "$ref": "#/$defs/actionTypeValues" },
                "count": { "type": "integer", "minimum": 0 },
                "time_span": { "type": "number", "minimum": 0 }
            }
        },

        "ruleDecision": {
            "type": "object",
            "required": ["explanation", "confidence"],
            "additionalProperties": false,
            "properties": {
                "risk_level": { "$ref": "#/$defs/riskLevelValues" },
                "enforcement_type": { "$ref": "#/$defs/enforcementTypeValues" },
                "allowed_actions": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/actionTypeValues" }
                },
                "explanation": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
        },

        "policyDecision": {
            "description": "The policy-level decision produced by compiling this policy's rules to Rego and combining every firing rule's rule_decision per rule_combining_mode (data_governance/risk/rules/rego.py). Same field set as ruleDecision plus triggered_rules and rule_combining_mode.",
            "type": "object",
            "required": ["explanation", "confidence"],
            "additionalProperties": false,
            "properties": {
                "risk_level": { "$ref": "#/$defs/riskLevelValues" },
                "enforcement_type": { "$ref": "#/$defs/enforcementTypeValues" },
                "allowed_actions": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/actionTypeValues" }
                },
                "explanation": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "triggered_rules": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "rule_combining_mode": { "$ref": "#/$defs/ruleCombiningModeValues" }
            }
        }
    }
}
