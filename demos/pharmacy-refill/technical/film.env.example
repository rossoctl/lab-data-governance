# film.env — this machine and the cluster the take runs on. cp film.env.example film.env, then edit.
# Every script in the package reads it (setup/, take/, film/). Keys are NOT kept here: export them in your shell.
#
# The defaults fit a Mac with no other kind cluster. If one already uses ports 8080/9443, pick others here
# (setup/sentry-film.sh check says so). An existing cluster can be reused: give its name and ports; `plan` tells you
# what would change in it before anything does.

CLUSTER=sentry-film                          # the kind cluster (created if absent)
HTTP_PORT=8080                               # host port of the cluster's gateway: http://dg.localtest.me:<port>/ui/traces
HTTPS_PORT=9443
KUBECONFIG=$HOME/.kube/sentry-film.kubeconfig   # one kubeconfig file for this cluster (your ~/.kube/config is left alone)
CLI_CONTEXT=sentry-film                      # the rossoctl CLI's context for this cluster (the current context is not changed)
SRC=$HOME/sentry-film/src                    # where the three checkouts go (setup clones them; outside Dropbox/iCloud is best)
LLM_MODEL=qwen2.5:7b                         # ollama on this Mac; the agents reach it at host.containers.internal:11434
PYTHON=python3.11                            # the film build: pyyaml, numpy, Pillow, faster-whisper
